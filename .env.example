# --- Database (any PostgreSQL 14+, UTF8). Local: `npm run db:start` serves this URL.
DATABASE_URL="postgresql://travora:travora@localhost:5434/travora"
# Used only by `npm test` — the suite WIPES this database. Must differ from DATABASE_URL.
TEST_DATABASE_URL="postgresql://travora:travora@localhost:5434/travora_test"

# --- Auth. 32+ random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it signs everyone out.
AUTH_SECRET=""

# --- Public base URL (links in emails, guest trip page URLs).
APP_URL="http://localhost:3000"

# --- File storage: "local" (disk, development only) | "vercel-blob" (private store).
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR=".data/uploads"
# For vercel-blob, also provide the store's BLOB_READ_WRITE_TOKEN. Optional key prefix:
STORAGE_BUCKET=""

# --- Email: "log" (records only; HTML saved to .data/emails) | "resend".
EMAIL_PROVIDER="log"
RESEND_API_KEY=""
EMAIL_FROM="TRAVORA <trips@your-domain.com>"

# --- Vercel Cron calls /api/cron/daily with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=""

# --- Show the development credentials box on /login outside development (demo deployments only).
SHOW_DEMO_CREDENTIALS="false"
